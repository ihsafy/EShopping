# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MySQL / MariaDB ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=eshopping
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10

# ---- JWT ----
# Generate a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=12h

# ---- CORS (comma separated list of allowed frontend origins) ----
CLIENT_URL=http://localhost:5173

# ---- Uploads ----
UPLOAD_DIR=./uploads

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=30

# ---- Admin seed account (development only) ----
# npm run db:admin uses these to create/update the default admin.
ADMIN_NAME=IH Safy
ADMIN_EMAIL=ihsafy2k21@gmail.com
ADMIN_PASSWORD=ihsafy2k21@gmail.com
ADMIN_MOBILE=01724612320
