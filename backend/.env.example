# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MySQL / MariaDB (local: XAMPP / MySQL on this machine) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=eshopping
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10

# ---- JWT ----
# Generate a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=12h

# ---- CORS (comma separated list of allowed frontend origins) ----
CLIENT_URL=http://localhost:5173

# ---- Uploads ----
UPLOAD_DIR=./uploads

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=30

# ---- Admin seed account (used only by `npm run db:admin`, never by the API) ----
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MOBILE=

# ============================================================================
#  PRODUCTION / VERCEL ONLY
#  Not needed locally. On Vercel the API cannot reach a database on your own
#  machine, so the DB_* names below must point at a remote host. DB_* wins over
#  the DATABASE_* names above, so setting them overrides the local values.
# ============================================================================
# DB_HOST=gateway01.region.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=eshopping
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_POOL_SIZE=5
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ---- Cloudinary (REQUIRED on Vercel for image uploads) ----
# Without these, uploads fall back to the serverless disk, which Vercel wipes on
# every cold start, so newly added product images would disappear.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=eshopping
