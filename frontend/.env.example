# Vite client-side configuration.
#
# VITE_API_URL is the only build-time variable the storefront needs, and it
# should normally be LEFT EMPTY.
#
# Empty  -> axios uses the relative "/api" base, so the browser calls
#           https://<your-domain>/api/... and Vercel's rewrite forwards it to
#           the Express service. Same origin, so no CORS setup is required.
#
# Set it ONLY if the API lives on a different domain than the storefront, e.g.
#   VITE_API_URL=https://api.example.com
# In that case that API must also allow this origin through CLIENT_URL.
#
# Note this is baked into the JS bundle at build time, so changing it requires a
# redeploy. Vite only exposes variables prefixed with VITE_.
VITE_API_URL=

# Optional store name used in page titles.
VITE_STORE_NAME=EShopping
