{
  "name": "eshopping",
  "version": "1.0.0",
  "private": true,
  "description": "EShopping - single vendor e-commerce (React + Express + MySQL)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "npm start --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "puppeteer-core": "^25.12.0"
  }
}
